# Site Configuration
NEXT_PUBLIC_SITE_URL=https://sidhya.studio

# Google Analytics 4 (Free: analytics.google.com)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Monetization & Developer Ads Configuration
# Carbon Ads (carbonads.net)
# NEXT_PUBLIC_CARBON_SERVE=CEBI6K3W
# NEXT_PUBLIC_CARBON_PLACEMENT=sidhyastudio

# Google AdSense (google.com/adsense)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=0987654321

# Enable/Disable Ads
# NEXT_PUBLIC_ENABLE_ADS=false

# Optional: Persistent Global Likes Database (Vercel KV or Upstash Redis)
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...

# Azure AI Studio & Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/openai/v1
AZURE_OPENAI_RESOURCE_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_AI_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini
AZURE_OPENAI_MODEL_NAME=gpt-5-mini

# Tavily AI Search API (Real-time web search for AI agents & RAG)
TAVILY_API_KEY=your_tavily_api_key_here
